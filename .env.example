# Neon pooled connection string — Dashboard → Connect → Connection string
# The owner role. Migrations, seeds, sign-in and rate limiting use this, and it
# can bypass row-level security — which is exactly why the request path does not.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# The same database as the `app_runtime` role, which cannot bypass row-level
# security. Every request-path query goes through this, so one firm's records
# are kept from another by the database rather than by each handler remembering.
# Obtain it by running the migrations and then:
#   node --experimental-strip-types --env-file=.env scripts/create-app-role.ts
APP_DATABASE_URL=postgresql://app_runtime:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# 32+ characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# dev | msg91 — no default, an unset value is a configuration mistake
OTP_PROVIDER=dev
# Required by the dev sender. It is deliberately awkward.
OTP_DEV_MODE=on
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Comma-separated origins a browser may call this API from.
# Not `*`: an explicit list is what stays correct when a second front end
# or a cookie arrives. Defaults to localhost:3000 and :3100 in development.
WEB_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200

# The domain the refresh cookie is set on, with a leading dot so it is shared
# between the app and the API subdomains — e.g. `.obizee.com`. Left unset in
# development, where the cookie is host-only on localhost and that is correct.
# COOKIE_DOMAIN=.obizee.com
