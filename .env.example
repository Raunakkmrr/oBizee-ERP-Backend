# Neon pooled connection string — Dashboard → Connect → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# 32+ characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# dev | msg91 — no default, an unset value is a configuration mistake
OTP_PROVIDER=dev
# Required by the dev sender. It is deliberately awkward.
OTP_DEV_MODE=on
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Comma-separated origins a browser may call this API from.
# Not `*`: an explicit list is what stays correct when a second front end
# or a cookie arrives. Defaults to localhost:3000 and :3100 in development.
WEB_ORIGINS=http://localhost:3000,http://localhost:3100
